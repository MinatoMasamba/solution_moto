# Copier ce fichier en .env et adapter les valeurs.

# dev en local ; mettre "prod" sur le serveur (PythonAnywhere, etc.)
DJANGO_ENV=dev

SECRET_KEY=change-me-in-production
DEBUG=True

# En prod, mettre le(s) domaine(s), ex:
# ALLOWED_HOSTS=sourceacademique.pythonanywhere.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Laisser vide en local pour utiliser SQLite, sinon:
# postgres://go_mboka:go_mboka@db:5432/go_mboka
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000

NPM_BIN_PATH=npm

# ── Emails (codes de réinitialisation motard) ─────────────────────────────
# dev : console (aucune config requise). prod : SMTP via EMAIL_HOST.
# EMAIL_HOST=smtp.votrefournisseur.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Go-Mboka <no-reply@go-mboka.cd>

# ── Paiements Mobile Money ─────────────────────────────────────────────────
# PAYMENT_PROVIDER=simulator        # simulator en attendant l'agrégateur réel
# GM_PAYMENT_SIMULATION=auto        # auto = charge acceptée immédiatement (dev)
#                                   # manual = reste pending jusqu'au webhook
# PAYMENTS_WEBHOOK_TOKEN=token-secret-de-l-agregateur
# SUBSCRIPTION_MONTHLY_AMOUNT=15000 # abonnement motard mensuel (CDF)

# ── Sécurité prod ──────────────────────────────────────────────────────────
# SECURE_SSL_REDIRECT=True          # requis pour la PWA (installable en HTTPS)
